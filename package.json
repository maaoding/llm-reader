{
  "name": "llm-reader",
  "version": "1.1.0",
  "private": true,
  "description": "A local-first desktop reader centered on grounded LLM-assisted reading.",
  "main": "out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/maaoding/llm-reader.git"
  },
  "author": "wrh37",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "copy:check": "vitest run tests/unit/ui-copy.test.ts",
    "build:electron": "electron-vite build",
    "build:app": "pnpm copy:check && pnpm build:electron",
    "build:win": "pnpm build:app && electron-builder --win nsis",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:run": "playwright test",
    "test:e2e": "pnpm build:app && pnpm test:e2e:run",
    "test:real-api": "pnpm build:app && node scripts/real-provider-smoke.mjs",
    "eval:book-context": "node scripts/book-context-eval.mjs",
    "eval:rerank": "node scripts/rerank-eval.mjs",
    "eval:document-structure": "node scripts/document-structure-eval.mjs",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:electron && pnpm test:e2e:run"
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "epubjs": "0.3.93",
    "jszip": "3.10.2",
    "lucide-react": "1.56.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.7.11",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
