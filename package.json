{
  "name": "llm-reader",
  "version": "0.3.0",
  "private": true,
  "description": "A local-first desktop reader centered on grounded LLM-assisted reading.",
  "main": "out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/maaoding/llm-reader.git"
  },
  "author": "wrh37",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "copy:check": "vitest run tests/unit/ui-copy.test.ts",
    "build:electron": "electron-vite build",
    "build:app": "pnpm copy:check && pnpm build:electron",
    "build:win": "pnpm build:app && electron-builder --win nsis",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:run": "playwright test",
    "test:e2e": "pnpm build:app && pnpm test:e2e:run",
    "test:all": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:electron && pnpm test:e2e:run"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "5.6.205",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
